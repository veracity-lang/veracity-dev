int main(int argc, string[] argv) {
    int x = int_of_string(argv[1]);
    int n = int_of_string(argv[2]);
    int[] arr = new int[n];
    int j = 0;

    commute _ {
        { 
            arr[x] = arr[x] / 2;
        }
        {
            /* for (int j = 0; j < n; j = j + 1;) {
                 arr[j] = arr[j] + 1;
            }*/
            arr[j] = arr[j] + 1;
        }
    }

    return 0;
}